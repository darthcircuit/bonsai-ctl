# Bonsai portable — server configuration.
# This file is dot-sourced by bonsai-ctl: every KEY=VALUE line below becomes an
# exported shell variable that controls the server. To change something, edit
# the line and re-run.

# Server bind address (127.0.0.1 = this machine only).
BONSAI_HOST=127.0.0.1

# Port the server listens on (and what opencode's provider points at).
PORT=8080

# GPU layers offloaded to the accelerator. 0 = CPU-only. 99 = all layers.
BONSAI_NGL=99

# Max context (tokens). Also drives the context limit of the local Bonsai model
# in opencode. 262144 = full trained context (needs ~48GB RAM).
BONSAI_CTX=131072

# Vision / image input. 1 = load the vision projector so the server accepts
# images AND opencode's Bonsai model advertises image input (default, since the
# 27B is a VLM). 0 = text-only (the projector is skipped, no image support).
BONSAI_VISION=1

# Experimental 4-bit (Q4_0) KV cache: 0 = off (default), 1 = on.
# Much less KV RAM for long contexts, slightly slower decode. For best quality
# with kv4 on, build a mean-centering bias first: ./scripts/make_kv_bias.sh
BONSAI_KV4=1

# Cap thinking in tokens. -1 or blank = uncapped.
BONSAI_REASONING_BUDGET=

# ── API / opencode provider ────────────────────────────────────────────────────
# Shared API key, used by llama-server and any harness that talks to it
# (opencode and future launchers all read this same value). When set, the
# server enforces it (clients must send it); when blank, it is unauthenticated.
# Leave blank for unauthenticated local use.
API_KEY=

# Optional output-token cap (tokens), shared by llama-server and the local
# Bonsai model as seen by harnesses (opencode and any future launcher). When
# set, it is passed to the server as --n-predict and written to the model's
# limit.output; left blank, no output cap is applied anywhere.
BONSAI_OUTPUT=
